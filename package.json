{
  "name": "e-commerce-nest-microservices",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build gateway && nest build auth-service && nest build product-service && nest build inventory-service && nest build cart-service && nest build order-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "prisma:auth:generate": "prisma generate --config apps/auth-service/prisma/prisma.config.ts",
    "prisma:auth:migrate": "prisma migrate dev --config apps/auth-service/prisma/prisma.config.ts",
    "prisma:auth:deploy": "prisma migrate deploy --config apps/auth-service/prisma/prisma.config.ts",
    "prisma:auth:seed": "prisma db execute --config apps/auth-service/prisma/prisma.config.ts --file apps/auth-service/prisma/seed.sql",
    "prisma:product:generate": "prisma generate --config apps/product-service/prisma/prisma.config.ts",
    "prisma:product:migrate": "prisma migrate dev --config apps/product-service/prisma/prisma.config.ts",
    "prisma:product:deploy": "prisma migrate deploy --config apps/product-service/prisma/prisma.config.ts",
    "prisma:product:seed": "prisma db execute --config apps/product-service/prisma/prisma.config.ts --file apps/product-service/prisma/seed.sql",
    "prisma:inventory:generate": "prisma generate --config apps/inventory-service/prisma/prisma.config.ts",
    "prisma:inventory:migrate": "prisma migrate dev --config apps/inventory-service/prisma/prisma.config.ts",
    "prisma:inventory:deploy": "prisma migrate deploy --config apps/inventory-service/prisma/prisma.config.ts",
    "prisma:inventory:seed": "prisma db execute --config apps/inventory-service/prisma/prisma.config.ts --file apps/inventory-service/prisma/seed.sql",
    "prisma:cart:generate": "prisma generate --config apps/cart-service/prisma/prisma.config.ts",
    "prisma:cart:migrate": "prisma migrate dev --config apps/cart-service/prisma/prisma.config.ts",
    "prisma:cart:deploy": "prisma migrate deploy --config apps/cart-service/prisma/prisma.config.ts",
    "prisma:order:generate": "prisma generate --config apps/order-service/prisma/prisma.config.ts",
    "prisma:order:migrate": "prisma migrate dev --config apps/order-service/prisma/prisma.config.ts",
    "prisma:order:deploy": "prisma migrate deploy --config apps/order-service/prisma/prisma.config.ts",
    "demo:seed": "npm run prisma:auth:seed && npm run prisma:product:seed && npm run prisma:inventory:seed",
    "start:dev:gateway": "nest start gateway --watch",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:product": "nest start product-service --watch",
    "start:dev:inventory": "nest start inventory-service --watch",
    "start:dev:cart": "nest start cart-service --watch",
    "start:dev:order": "nest start order-service --watch",
    "start:prod:gateway": "node dist/apps/gateway/main.js",
    "start:prod:auth": "node dist/apps/auth-service/main.js",
    "start:prod:product": "node dist/apps/product-service/main.js",
    "start:prod:inventory": "node dist/apps/inventory-service/main.js",
    "start:prod:cart": "node dist/apps/cart-service/main.js",
    "start:prod:order": "node dist/apps/order-service/main.js",
    "demo": "bash scripts/start-demo.sh",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/microservices": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "11.4.4",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "kafkajs": "2.2.4",
    "protobufjs": "7.6.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@types/bcrypt": "6.0.0",
    "@types/node": "26.0.1",
    "eslint": "10.5.0",
    "globals": "17.7.0",
    "prettier": "3.8.4",
    "prisma": "7.8.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
