NODE_ENV=development

PRODUCT_CACHE_ENABLED=true
PRODUCT_REDIS_URL=redis://127.0.0.1:6380
PRODUCT_CACHE_TTL_SECONDS=30
PRODUCT_CACHE_TIMEOUT_MS=100
PRODUCT_CACHE_DEBUG=false

GATEWAY_PORT=4000
PRODUCT_SERVICE_PORT=4001
CART_SERVICE_PORT=4002
INVENTORY_SERVICE_PORT=4003
ORDER_SERVICE_PORT=4004
AUTH_SERVICE_PORT=4005

AUTH_GRPC_URL=localhost:9005
PRODUCT_GRPC_URL=localhost:9001
INVENTORY_GRPC_URL=localhost:9003
ORDER_GRPC_URL=localhost:9004


JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=10h

KAFKA_BROKERS=localhost:9094
PRODUCT_EVENTS_TOPIC=product-events
FLASH_SALE_EVENTS_TOPIC=flash-sale-events
INVENTORY_KAFKA_GROUP_ID=inventory-service
INVENTORY_FLASH_SALE_KAFKA_GROUP_ID=inventory-flash-sale-service
PRODUCT_OUTBOX_POLL_INTERVAL_MS=2000
PRODUCT_OUTBOX_BATCH_SIZE=20
PRODUCT_OUTBOX_LEASE_MS=30000
PRODUCT_OUTBOX_SHUTDOWN_TIMEOUT_MS=10000
PRODUCT_OUTBOX_MAX_ATTEMPTS=5
CHECKOUT_RECONCILIATION_POLL_INTERVAL_MS=2000
CHECKOUT_RECONCILIATION_BATCH_SIZE=20
CHECKOUT_RECONCILIATION_LEASE_MS=30000
CHECKOUT_RECONCILIATION_SHUTDOWN_TIMEOUT_MS=10000
CHECKOUT_RECONCILIATION_MAX_ATTEMPTS=5

AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5005/auth_db
PRODUCT_DATABASE_URL=postgresql://postgres:postgres@localhost:5001/product_db
CART_DATABASE_URL=postgresql://postgres:postgres@localhost:5002/cart_db
INVENTORY_DATABASE_URL=postgresql://postgres:postgres@localhost:5003/inventory_db
ORDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5004/order_db

# Internal gRPC calls and bounded consumer shutdown.
CART_GRPC_URL=localhost:9002
CART_GRPC_PORT=9002
GRPC_REQUEST_TIMEOUT_MS=5000
GATEWAY_CHECKOUT_TIMEOUT_MS=30000
KAFKA_CONSUMER_SHUTDOWN_TIMEOUT_MS=10000
